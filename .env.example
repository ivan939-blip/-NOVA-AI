# Optional public project values from Supabase → Project Settings → API.
# Add these only to enable sign-in and cloud library sync in Cloudflare Pages.
# Keep Row Level Security enabled. Never expose a Supabase service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional free, local neural-video companion. Do not put these in Cloudflare Pages.
# Start ComfyUI separately, then export a valid API workflow containing {{PROMPT}}.
NOVA_COMFYUI_URL=http://127.0.0.1:8188
NOVA_COMFY_WORKFLOW=C:\absolute\path\to\wan-api-workflow.json
